// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}


model User {
    id        String   @id @default(uuid())
    name      String
    email     String   @unique
    password  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    cars      Car[]
    reminders Reminder[]

    @@index([email])
}


model Car {
    id               String    @id @default(uuid())
    userId           String
    
    make             String
    model            String
    year             Int   
    vin              String?   @unique
    licensePlate     String?   
    color            String?
    
    currentMileage   Int       @default(0)
    mileageUnit      String    @default("km")
    
    purchaseDate     DateTime?
    purchasePrice    Float?
    purchaseMileage  Int?

    img              String?
    
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt
    
    user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    maintenanceRecords  MaintenanceRecord[]
    reminders           Reminder[]

    @@index([userId])
    @@index([vin])
}

model MaintenanceRecord {
    id                    String    @id @default(uuid())
    carId                 String
    
    serviceId             String
    serviceType           String
    category              String
    priority              String
    
    description           String?   @db.Text
    serviceProvider       String?
    serviceCost           Float?
    estimatedCostMin      Float?
    estimatedCostMax      Float?
    
    mileageAtService      Int
    scheduledMileage      Int
    
    serviceDate           DateTime  @default(now())
    scheduledDays         Int?
    
    partsReplaced         String?   @db.Text
    
    status                serviceStatus    @default(COMPLETED)
    isScheduled           Boolean          @default(false)
    
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt
    
    car                   Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
    
    @@index([carId])
    @@index([serviceDate])
    @@index([serviceType])
    @@index([serviceId])
    @@index([status])
    @@index([isScheduled])
    @@unique([serviceId, scheduledMileage])
}

enum serviceStatus {
    COMPLETED
    SCHEDULED
    OVERDUE
    SKIPPED
}

model Reminder {
    id               String    @id @default(uuid())
    userId           String
    carId            String
    
    title            String
    description      String?   @db.Text
    reminderType     String
    
    dueDate          DateTime?
    dueMileage       Int? 
    
    status           String    @default("active")
    isRecurring      Boolean   @default(false)
    recurringInterval Int?
    
    notifyDaysBefore Int       @default(7)
    notifyMilesBefore Int      @default(500)
    
    completedAt      DateTime?
    completedMileage Int?
    
    notes            String?   @db.Text
    priority         String    @default("medium")
    
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt
    
    user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    car              Car       @relation(fields: [carId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([carId])
    @@index([status])
    @@index([dueDate])
    @@index([dueMileage])
}
